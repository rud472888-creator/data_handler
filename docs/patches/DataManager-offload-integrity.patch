+def _single_clip_plan(tmp_path: Path, run_name: str = "R#1") -> DestinationPlan:
+    return DestinationPlan(
+        project_name="Project",
+        replica_paths=(ReplicaPath(path_id="path1", root=tmp_path / "path1"),),
+        footage_run_name=run_name,
+    )
+
